// Offcut Supply: the demo store reup buys from. Its own Worker, its own D1, and one Durable Object that ships orders 20 seconds later.
// Secrets (SUPPLY_WEBHOOK_SECRET, ACCOUNT_PASSWORD, ADMIN_PASSWORD) are set with wrangler secret, from Infisical.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "offcut-supply",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // global_fetch_strictly_public: the store tells the hub about an order with a fetch, and both Workers sit on the same
  // zone. On workers.dev, without the flag, Cloudflare refused that fetch from a request (error 1042), so "order confirmed"
  // never reached the hub. Only "shipped", sent from the Shipper's alarm 20 seconds later, did.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // The store's address on the team's domain. workers_dev stays on so the old address keeps answering.
  "workers_dev": true,
  "routes": [{ "pattern": "offcut.wheredidallmyinventorygo.wtf", "custom_domain": true }],
  "durable_objects": { "bindings": [{ "name": "SHIPPER", "class_name": "Shipper" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Shipper"] }],
  "d1_databases": [{ "binding": "DB", "database_name": "offcut-supply", "migrations_dir": "migrations" }],
  "vars": {
    // The hub's address on the team's domain. The store posts "order confirmed" and "shipped" to it.
    "HUB_URL": "https://wheredidallmyinventorygo.wtf",
    "ACCOUNT_EMAIL": "shop@reup.test",
    "SHIP_DELAY_MS": "20000",
    "TIME_ZONE": "America/Toronto"
  },
  "observability": { "enabled": true }
}
